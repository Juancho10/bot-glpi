---

import logo from '../assets/logo.png'; 
import Avatar from './Avatar.astro';

---

<header class="flex justify-between items-center  bg-blue-50 shadow-lg shadow-blue-900/50 ">
    <div class="flex items-center m-5">
        <Avatar/>
        <div class="flex flex-col gap-3"  >
            <h1 class="text-2xl font-DejaVu font-stretch-expanded font-bold">OmiBot</h1>
            <p class="text-2xl font-Montserrat font-light">Asistente de soporte</p>
        </div>
    </div>
    <div>
        <img src={logo.src} alt="Logo" class="w-15 mr-15"/>
    </div>
</header>