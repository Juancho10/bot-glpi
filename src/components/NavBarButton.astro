---
const {href = '#', active = false} = Astro.props;
---

<a href={href} class=`w-full flex-row justify-center text-white cursor-pointer hover:bg-[#4e5861] focus:ring-4 focus:outline-none focus:ring-[#001848]/50 font-medium rounded-lg px-5 py-2.5 text-center inline-flex items-center space-x-2 dark:focus:ring-[#4e5861]/55 mr-2 mb-2 hover:shadow-lg transition-all duration-100 ease-in-out hover:scale-110 scale-90 gap-x-2 opacity-70 hover:opacity-100 border-b-2 border-[#4e5861] `>
    <slot name="before" />
    <slot />
    <slot name="after" />

</a>